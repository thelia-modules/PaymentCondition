{# Customer family condition matrix fragment (loaded via AJAX into the module config page) #}
<div class="card mb-3">
    <div class="card-body">
        <h4 class="card-title">{{ 'Condition by customer family'|trans({}, 'paymentcondition.bo.default') }}</h4>
        <div class="table-responsive">
            <table class="table table-striped table-sm">
                <thead>
                    <tr>
                        <td colspan="3"></td>
                        {% for code in module_codes %}
                            <td>{{ code }}</td>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for family_id, item in paymentFamilyCondition %}
                        <tr>
                            <td>{{ family_codes[family_id] }}</td>
                            <td colspan="2"></td>
                            {% for payment_id, is_valid in item %}
                                <td>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input customer_family_condition_switch" type="checkbox"
                                               data-module="{{ payment_id }}" data-family="{{ family_id }}"
                                               {{ is_valid ? 'checked' : '' }}>
                                    </div>
                                </td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    (function () {
        var url = "{{ path('payment_condition_customer_family_condition_save') }}?_token={{ assignToken() }}";
        document.querySelectorAll('.customer_family_condition_switch').forEach(function (input) {
            input.addEventListener('change', function () {
                var checkbox = this;
                fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
                    body: new URLSearchParams({
                        customerFamilyId: checkbox.dataset.family,
                        moduleId: checkbox.dataset.module,
                        isValid: checkbox.checked ? 'true' : 'false'
                    })
                }).then(function (response) {
                    if (!response.ok) {
                        checkbox.checked = !checkbox.checked;
                    }
                }).catch(function () {
                    checkbox.checked = !checkbox.checked;
                });
            });
        });
    })();
</script>
