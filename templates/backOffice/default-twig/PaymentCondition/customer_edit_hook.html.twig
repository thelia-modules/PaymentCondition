{# customer.edit hook fragment — payment conditions for the edited customer #}
<div class="card mb-3">
    <div class="card-header">
        <h5 class="card-title mb-0">{{ 'Payment conditions for this customer'|trans({}, 'paymentcondition.bo.default') }}</h5>
    </div>
    <div class="card-body">
        {% if paymentCustomerCondition is null or paymentCustomerCondition.moduleRestrictionActive == 0 %}
            <div class="alert alert-info mb-0">
                {{ 'Payment restrictions is not activated for this customer'|trans({}, 'paymentcondition.bo.default') }}
            </div>
        {% else %}
            <h3 class="h6">{{ 'Allowed payments :'|trans({}, 'paymentcondition.bo.default') }}</h3>
            <ul class="mb-0">
                {% for allowedModule in allowedModules %}
                    <li>{{ allowedModule.title }} ({{ allowedModule.code }})</li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</div>
